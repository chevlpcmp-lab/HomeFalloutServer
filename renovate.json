{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)platform/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Group media container updates",
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["platform/components/media-stack/**"],
      "groupName": "media stack images"
    }
  ]
}
