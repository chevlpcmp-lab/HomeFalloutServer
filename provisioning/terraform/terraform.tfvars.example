proxmox_endpoint  = "https://10.0.0.254:8006"
proxmox_api_token = "terraform@pve!homefallout=REPLACE_ME"
cloud_image_node  = "home"

ssh_public_keys = [
  "REPLACE_WITH_CONTENTS_OF_C:\\Users\\Charles\\.ssh\\homefallout_ed25519.pub",
]

k3s_token = "REPLACE_ME"

# One control plane and two workers allocate all 28 logical CPUs while reserving
# roughly 3 GB RAM for Proxmox. Every OS/config disk stays on `local`; only bulk
# media and photos use `local-lvm`.
nodes = {
  "k3s-cp-01" = {
    proxmox_node = "home"
    vmid         = 220
    ip           = "10.0.0.10"
    role         = "server"
    pool         = "control"
    cores        = 4
    memory_mb    = 2048
    disk_gb      = 20
    datastore    = "local"
    description  = "k3s control plane"
    taints       = ["node-role.kubernetes.io/control-plane=true:NoSchedule"]
  }
  "k3s-apps-01" = {
    proxmox_node = "home"
    vmid         = 240
    ip           = "10.0.0.11"
    role         = "agent"
    pool         = "apps"
    cores        = 8
    memory_mb    = 3072
    disk_gb      = 20
    datastore    = "local"
    description  = "k3s applications worker"
  }
  "k3s-media-01" = {
    proxmox_node = "home"
    vmid         = 230
    ip           = "10.0.0.12"
    role         = "agent"
    pool         = "media"
    cores        = 16
    memory_mb    = 7168
    disk_gb      = 48
    datastore    = "local"
    data_disk_gb = 600
    data_disk_datastore = "local-lvm"
    data_disk_serial = "HOMEFALLOUT_DATA"
    description  = "k3s media, Jellyfin, and Immich worker"
  }
}
